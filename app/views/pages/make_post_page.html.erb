<%= stylesheet_link_tag 'postStyle' %>


<div class="makePostForm">
  <div class="headline">Make new post</div>
    <div class="form-container">
      <% if @post.errors.any? %>
        <div class="form-errors">
          <h4><%= pluralize(@post.errors.count, "error") %> prohibited this post from being saved:</h4>
          <ul>
            <% @post.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with(model: @post, url: create_post_posts_path, local: true, html: { class: "createPostForm" }) do |f| %>
        <div class="subject-input-container">
          <label for="post_title" class="headline">Subject</label>
          <%= f.text_area :title, class: "titleInput", maxlength: 250 %>
        </div>
        <hr>
        <div class="category-input-container">
          <label for="post_category_id" class="headline">Category</label>
          <div class="category-checkboxes">
            <%= f.collection_select :category_id, Category.all, :id, :name, { prompt: "Select a category" }, class: "form-control" %>
          </div>
        </div>
        <hr>
        <div class="content-input-container">
          <label for="post_content" class="headline">Content</label>
          <%= f.text_area :content, class: "titleInput", maxlength: 150 %>
        </div>

        <%= f.submit "Create post", class: "btn btn-warning" %>
      <% end %>
    </div>
</div>
