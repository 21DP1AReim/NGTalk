(() => {
  let formHtml = `<%= j render("comments/form", post: @parent_comment.post, comment: @comment, local: false) %>`;

  // Remove existing reply forms
  document.querySelectorAll('.reply-form-container').forEach(el => el.remove());

  const container = document.querySelector('#replies-container-<%= @parent_comment.id %>');
  if (container) {
    const formContainer = document.createElement('div');
    formContainer.className = 'reply-form-container';
    formContainer.innerHTML = formHtml;
    container.prepend(formContainer);
  }

  if (window.initCommentForms) {
    window.initCommentForms();
  }
})();