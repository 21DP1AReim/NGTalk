<% if user_signed_in? %>
  <%= form_with(model: [post, comment], local: local_assigns.fetch(:local, true), id: dom_id(comment, 'form'), class: 'comment-form') do |f| %>
    <%= f.hidden_field :parent_id %>
    
    <div class="form-group">
      <%= f.text_area :body, class: 'form-control', rows: 3,
                    placeholder: "Write your #{comment.parent_id? ? 'reply' : 'comment'}...",
                    data: { behavior: "comment-textarea" } %>
    </div>
    
    <div class="actions">
      <%= f.submit "Post #{comment.parent_id? ? 'reply' : 'comment'}", 
                 class: 'btn btn-primary',
                 disabled: true,
                 data: { disable_with: "Posting..." } %>
    </div>
    
    <% if comment.errors.any? %>
      <div class="alert alert-danger">
        <%= comment.errors.full_messages.join(', ') %>
      </div>
    <% end %>
  <% end %>
<% else %>
  <p>Please <%= link_to 'sign in', new_user_session_path %> to leave a comment.</p>
<% end %>

<script>
// Make the function globally available
window.initializeCommentForms = function() {
  document.querySelectorAll('.comment-form').forEach(form => {
    const textarea = form.querySelector('textarea');
    const submitBtn = form.querySelector('input[type="submit"]');
    const minLength = 1;
    
    if (textarea && submitBtn) {
      const checkValidity = () => {
        submitBtn.disabled = textarea.value.length < minLength;
      };
      
      textarea.addEventListener('input', checkValidity);
      checkValidity(); // Initialize immediately
    }
  });
};

// Initialize forms on page load
document.addEventListener('turbolinks:load', window.initializeCommentForms);
</script>