<div class="comment-form-container mt-4">
<% if user_signed_in? %>
  <%= form_with(model: [post, comment], local: local_assigns.fetch(:local, true), id: dom_id(comment, 'form'), class: 'comment-form') do |f| %>
    <%= f.hidden_field :parent_id, value: comment.parent_id %>
    
    <div class="form-group">
      <%= f.text_area :body, class: 'form-control', rows: 3,
                    placeholder: "Write your #{comment.parent_id? ? 'reply' : 'comment'}...",
                    data: { behavior: "comment-textarea" } %>
    </div>
    
    <div class="actions">
      <%= f.submit "Post #{comment.parent_id? ? 'reply' : 'comment'}", 
                 class: 'btn btn-primary',
                 disabled: true,
                 data: { disable_with: "Posting..." } %>
    </div>
    
    <% if comment.errors.any? %>
      <div class="alert alert-danger">
        <%= comment.errors.full_messages.join(', ') %>
      </div>
    <% end %>
  <% end %>
<% else %>
  <p>Login or register to add your comment to the discussion.</p>
<% end %>
</div>
