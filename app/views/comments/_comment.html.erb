<div class="comment" id="comment-<%= comment.id %>">
  <div class="commentContainer">
<div class="commenterContainer d-flex justify-content-between align-items-center align-items-start w-100">
  <div class="commenter"><strong><%= comment.user.user_name %></strong></div>

  <% if user_signed_in? %>
    <% can_delete_comment = current_user.admin? || current_user == comment.user %>

    <% if can_delete_comment %>
      <div class="dropdown">
        <button class="btn btn-3dots dropdown-toggle" type="button" id="commentActionsDropdown-<%= comment.id %>" data-bs-toggle="dropdown" aria-expanded="false">
          &#x22EE;
        </button>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="commentActionsDropdown-<%= comment.id %>">
          <li>
            <%= form_with(url: post_comment_path(comment.post, comment), method: :delete, local: true) do |f| %>
              <%= f.hidden_field :id, value: comment.id %>
              <%= f.submit "Delete", data: { confirm: "Are you sure?" }, class: "dropdown-item text-danger" %>
            <% end %>
          </li>
        </ul>
      </div>
    <% end %>
  <% end %>

    </div>
    
    <div class="commentBody"><%= comment.body %></div>
    
    <div class="commentFooter">
      <%= time_ago_in_words(comment.created_at) %>
      <% if user_signed_in? %>
      <%= link_to 'Reply', reply_post_comment_path(comment.post, comment),
                  remote: true,
                  class: 'reply-button linkStyling',
                  data: { comment_id: comment.id } %>
      <% end %>
    </div>
  </div>

  <div class="replies" id="replies-container-<%= comment.id %>">
    <% comment.replies.each do |reply| %>
      <%= render partial: 'comments/comment', locals: { comment: reply } %>
    <% end %>
  </div>
</div>




