<div class="comment" id="comment-<%= comment.id %>">
  <div class="commentContainer">
    <div class="commenterContainer">
      <div class="commenter"><strong><%= comment.user.user_name %></strong></div>
      <% if user_signed_in? && (current_user == comment.user || current_user.admin?) %>
        <%= form_with(url: post_comment_path(comment.post, comment), method: :delete, local: true) do |f| %>
          <%= f.hidden_field :id, value: comment.id %>
          <%= f.submit "Delete", data: { confirm: "Are you sure?" }, class: "delete-button" %>
        <% end %>
      <% end %>
    </div>
    
    <div class="commentBody"><%= comment.body %></div>
    
    <div class="commentFooter">
      <%= time_ago_in_words(comment.created_at) %> ago
      <% if user_signed_in? %>
        <%= link_to 'Reply', reply_post_comment_path(comment.post, comment), 
                    remote: true, 
                    class: 'reply-button linkStyling', 
                    data: { comment_id: comment.id } %>
      <% end %>
    </div>
  </div>

  <div class="replies" id="replies-container-<%= comment.id %>">
    <% comment.replies.each do |reply| %>
      <%= render partial: 'comments/comment', locals: { comment: reply } %>
    <% end %>
  </div>
</div>

<script>
// Single global form tracker
window.currentReplyForm = null;

function setupReplyButtons() {
  document.querySelectorAll('.reply-button').forEach(button => {
    button.addEventListener('click', function(e) {
      e.preventDefault();
      const commentId = this.dataset.commentId;
      
      // Remove existing form if any
      if (window.currentReplyForm) {
        window.currentReplyForm.remove();
        window.currentReplyForm = null;
        
        // If clicking same button, just exit
        if (this.dataset.active === 'true') {
          this.dataset.active = 'false';
          return;
        }
      }
      
      // Mark button as active
      this.dataset.active = 'true';
      
      // Create form container
      const container = document.getElementById(`replies-container-${commentId}`);
      const formDiv = document.createElement('div');
      formDiv.className = 'reply-form-container';
      container.prepend(formDiv);
      window.currentReplyForm = formDiv;
      
      // Load form via AJAX
      fetch(this.href, {
        headers: { 
          'Accept': 'text/javascript',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        }
      })
      .then(response => response.text())
      .then(html => {
        formDiv.innerHTML = html;
        if (window.initializeCommentForms) window.initializeCommentForms();
      })
      .catch(() => {
        formDiv.innerHTML = 'Error loading form';
      });
    });
  });
}

// Initialize on page load
document.addEventListener('turbolinks:load', setupReplyButtons);
</script>
