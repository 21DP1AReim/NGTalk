<% if @comment.persisted? %>
  // Add the new reply
  document.querySelector(`#replies-container-<%= @comment.parent_id %>`)
          .insertAdjacentHTML('beforeend', '<%= j render @comment %>');
  
  // Clear the active form
  if (window.currentReplyForm) {
    window.currentReplyForm.remove();
    window.currentReplyForm = null;
  }
<% else %>
  // Show errors in existing form
  alert('<%= @comment.errors.full_messages.join("\n") %>');
<% end %>