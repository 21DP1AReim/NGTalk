

  <div class="posts-list">
  
    <% if @posts.any? %>
    <div class="container">
        <h1>Your Activity</h1>

        <div class="tabs">
            <ul class="nav nav-tabs">
            <li class="nav-item">
                <%= link_to "All Activity", "#", class: "nav-link active" %>
            </li>
            </ul>
        </div>
      <% @posts.each do |post| %>
        <div class="card mb-3">
          <div class="card-body">
            <h5 class="card-title">
              <%= link_to post.title, post %>
              <% if post.author == current_user %>
                <span class="badge bg-primary">Your Post</span>
              <% end %>
            </h5>
            
            <p class="card-text"><%= truncate(post.content, length: 150) %></p>
            
            <div class="d-flex justify-content-between align-items-center">
              <small class="text-muted">
                Created 
                <%= time_ago_in_words(post.created_at) %> ago
              </small>
              
              <% if current_user.comments.where(post: post).any? %>
                <small>
                  <%= pluralize(current_user.comments.where(post: post).count, 'comment') %>
                </small>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="alert alert-info">No activity to show yet.</div>
    <% end %>
  </div>
