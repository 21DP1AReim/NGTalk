<%= stylesheet_link_tag 'postStyle' %>
<% if results.any? %>
<h1>Search Results:</h2>
  <div class="containerPostTable">
    <table class="tablePosts">
      <thead>
        <tr>
          <th class="tableHeader">Title</th>
          <th class="tableHeader">Type</th>
          <th class="tableHeader">Category</th>
          <th class="tableHeader">Replies
          </th>
          <th class="tableHeader">Activity
          </th>
        </tr>
      </thead>
      <tbody id="table-body">

        <% results.sort_by(&:updated_at).reverse.each do |result| %>
          <tr class="tableRow">
            <td class="tableTitle"><%= link_to result.title, send("#{result.class.name.downcase}_path", result) %></td>
            <td class="tableTitle" style="min-width: 100px;"><%= result.post_type.humanize %></td>
            <td class="tableTitle" style="min-width: 150px;">
              <%= result.category&.name || "No category" %>
            </td>
            <td class="tableReplies" style="min-width: 150px;">
              <%=result.comments.count %>
            </td>
            <td class="tableLastUpdated "style="min-width: 150px;"><%= time_ago_in_words(result.updated_at) %></td>
          </tr>
        <% end %>


      </tbody>
    </table>
  </div>
<% else %>
  <p>No results found.</p>
<% end %>