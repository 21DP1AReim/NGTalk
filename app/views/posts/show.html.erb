<%= stylesheet_link_tag 'postStyle' %>
<%#Render modal for post archiving%>
<%= render 'posts/delete_modal' %>
<div style="padding-left:5%; padding-right:5%; min-height:95vh" class="container mb-3 mt-3">
  <div class="row gx-5">
    <div class="col-md-9 mt-3">
        <div>
          <div class="container-for-post mb-4">
          <div class="postTitleContainer">
            <div class="postTitle"><%= @post.title %></div>
            <div class="postHeaderRight">
                <span class="postAuthor"><%= @author&.user_name || 'Unknown Author' %></span>
              <% if user_signed_in? %>
                <% can_edit = current_user == @post.author && @post.created_at > 15.minutes.ago %>
                <% can_archive = current_user.admin? %>
                <% can_delete_forever = current_user.admin? %>
                <% if can_edit || can_archive || can_delete_forever %>
                  <div class="dropdown">
                    <button class="btn btn-3dots dropdown-toggle" type="button" id="postActionsDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                      &#x22EE;
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="postActionsDropdown">
                      <% if can_edit || current_user.admin? %>
                        <li>
                          <%= link_to 'Edit', edit_post_path(@post), remote: true, id: 'edit-post-link', data: { post_id: @post.id }, class: 'dropdown-item' %>
                        </li>
                      <% end %>

                      <% if @post.archived_at? && can_delete_forever %>
                        <li>
                          <%= button_to "Delete Forever", purge_post_path(@post), method: :delete, class: 'dropdown-item text-danger', data: { confirm: "Are you sure you want to delete this post forever?" } %>
                        </li>
                        <li>
                          <%= button_to "Restore Post", restore_post_path(@post), method: :patch, class: 'dropdown-item', data: { confirm: "Are you sure you want to restore this post ? A notification will be sent to the user" } %>
                        </li>
                      <% elsif !@post.archived_at? && can_archive %>
                        <li>
                          <button class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">Archive</button>
                        </li>
                      <% end %>
                    </ul>
                  </div>
                <% end %>
              <% end %>
            </div>
            </div>
            <div class="postContent"><%= raw(@post.content.gsub(/\s+/," ")) %></div>
              
            <div class="postFooter d-flex justify-content-between align-items-center">
              <span class="postDate"><%= @post.created_at.strftime("%Y-%m-%d %H:%M") %></span>
              <% if @post.category %>
                <span class="postCategory"><%= @post.category.name %></span>
              <% end %>
            </div>
          </div>

          

        <div id="comments" data-target="comments">
          
          <% @post.comments.where(parent_id: nil).each do |comment| %>
            <%= render partial: 'comments/comment', locals: { comment: comment } %>
          <% end %>
          <%= render partial: 'comments/form', locals: { post: @post, comment: @comment } %>
        </div>
        
        </div>
      </div>
      <div class="col-md-3">
        <div id="recentActivity" > </div>
        <h1 class="recentHeader">Recent Activity</h1>
        <div class="recent">
          <% if @recent_posts.any? %>
            <div class='recentActivityListContainer'>
              <% @recent_posts.each do |post| %>
                <% total_count = post.comments.count + post.comments.sum { |c| c.replies.count } %>
                <a class="recentActivityAnchor" href="<%= post_path(post) %>">
                  <span class="topic"><%= post.title %></span> <%= total_count %>
                </a>
              <% end %>
            </div>  
          <% else %>
            <p>No recent activity</p>
          <% end %>
          <% if user_signed_in? %>
            <div class="btnIg">
              <%= link_to 'Make new post', make_post_page_path, class:"linkStyling" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

           
              
<script>
document.addEventListener('DOMContentLoaded', function() {
  $('#edit-post-link').on('click', function(e) {
    e.preventDefault();
    var postId = $(this).data('post-id');
    $.ajax({
      url: '/posts/' + postId + '/edit',
      type: 'GET',
      success: function(response) {
        console.log(response); 
        $('.container-for-post').html(response);
      },
      error: function(xhr) {
        console.log(xhr.responseText);
      }
    });
  });
});
</script>
<script>
// Make the function globally available
document.addEventListener('ajax:success', function(event) {
  if (event.target.classList.contains('reply-button')) {
    if (window.initializeCommentForms) window.initializeCommentForms();
  }
});

</script>