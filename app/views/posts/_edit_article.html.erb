<%= form_with(model: @post, local: true) do |f| %>
  <div class="headline">Title</div>
  <%= f.text_area :title, class: "titleInput", maxlength: 50 %>

  <div class="category-input-container">
    <label for="post_category_id" class="headline">Category</label>
    <div class="category-checkboxes">
      <%= f.collection_select :category_id, Category.all, :id, :name, { prompt: "Select a category" }, class: "form-control" %>
    </div>
  </div>

  <div>
    <%= f.label :content %><br>
    <%= f.text_area :content, class: "tinymce" %>
    <%= tinymce %><br>
  </div>

  <%= f.hidden_field :post_type, value: 'article' %>
  <%= f.submit "Update Article", class: "btn btn-warning" %>
<% end %>