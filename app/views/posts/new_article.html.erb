
<div class="container">
  <div class="makePostForm"> 
    <%= form_with(model: @post, url: create_article_posts_path, local: true, scope: :post) do |f| %>
      <div>
        <%= f.label :title %> <br>
        <%= f.text_area :title, class: "titleTxt", maxlength: 50 %> <br>
      </div>
        <%= f.label :category %> <br>
        <%= f.text_field :category %>
      
      <div>
        <%= f.label :content %> <br>
        <%= f.text_area :content, class: "tinymce" %>
        <%= tinymce %> <br>
      </div>  
      <%= f.submit "Create Article", class: "btn btn-warning" %> <br>
    <% end %>
  </div>
</div>