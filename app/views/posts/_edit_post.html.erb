<div class="editPostForm">
  <div class="headline">Change post information</div>

      <% if post.errors.any? %>
      <div class="alert alert-danger">
        <ul>
          <% post.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-container">
      <%= form_with(model: @post, remote: true, html: { class: "createPostForm" }) do |f| %>
        <div class="subject-input-container">
          <label for="post_title" class="headline">Subject</label>
          <%= f.text_area :title, class: "titleInput", maxlength: 30 %>
        </div>
        <hr>
        <div class="category-input-container">
          <label for="post_category_id" class="headline">Category</label>
          <div class="category-checkboxes">
            <%= f.collection_select :category_id, Category.all, :id, :name, { prompt: "Select a category" }, class: "form-control" %>
          </div>
        </div>
        <hr>
        <div class="content-input-container">
          <label for="post_content" class="headline">Content</label>
          <%= f.text_area :content, class: "titleInput", maxlength: 150 %>
        </div>

        <%= link_to 'Cancel', post_path(@post), class: "btn btn-secondary" %>
        <%= f.submit "Update post", class: "btn btn-warning float-end" %>
        
      <% end %>
    </div>
</div>