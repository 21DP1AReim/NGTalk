<!DOCTYPE html>
<html lang="en">
<head>
  <%= stylesheet_link_tag 'sharedStyling' %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forum</title>

</head>
<%#Load the partial for category management, only shows for admins%>
<%= render 'categories/manage_categories' %>
<%#Boostrap modal for user login, and link to user registration%>
<div class="modal fade" tabindex="-1" role="dialog" aria-labelledby="loginModalLabel" aria-hidden="true" id="loginModal">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header row">
          <% resource ||= User.new %>
          <% resource_name = :user %>
        <%#Form to authenticate user - for user login%>
        <%= form_for(resource, as: resource_name, url: session_path(resource_name), remote: true, html: { class: "login-form", id: "loginModalForm", data: { type: :html } }) do |f| %>          <div id="loginModalErrors"></div>
          <div class="col-12 mt-2 mb-2">
            <%#Input for user email%>
            <input type="text" name="user[email]" class="loginInput" required="required" placeholder="Email">
          </div>
          <div class="col-12 mb-2 mt-2">
            <%#Input for user password%>
            <input type="password" name="user[password]" class="loginInput" required="required" placeholder="Password">
          </div>
          <%#Submit button to log in, form uses devise to authenticate user data, if data is wrong then will show an error at top of modal%>
          <div class="col-12 mt-2 mb-2">
            <%= f.submit "Log in", class: "login-button button", name: "login", id: "loginModalSubmit" %>
          </div>
        <% end %>
        <hr>
        <%#Link to registration page if user does not have an account, registration made with help of devise%>
        <div class="col-12">
          <a href="<%= new_user_registration_path %>" class="signup-button button">Sign up</a>
        </div>
      </div>
    </div>
  </div>
</div>

<body style="height:100 vh">
  <div class="top-container">
    <div class="m-1" >
      <%#Navbar menu for easier navigation throughout the system, created using boostrap%>
      <nav id="top-nav" class="navbar navbar-expand-lg navbar-dark bg-dark basePadding">
        <div class="container-fluid">
          <%#System logo, which also acts as a link to main page, when clicked%>
          <a class="navbar-brand" href="<%= main_page_path %>"> <%= image_tag "NGTalkLogo.png", class: "img-fluid d-inline-block align-top", height:"100", width:"100", alt: "" %> </a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#myNav" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          <%#Collapsable menu, when screen width reaches a certain threshhold%>
          <div id="myNav" class="collapse navbar-collapse">
            <ul class="nav navbar-nav">
              <%#Link to redirect user to main page%>
              <li class="nav-item">
                <%= link_to "Home", main_page_path, class: "nav-link navTextStyling", style: "color:azure;", id: "navHome" %>
              </li>
              <%#Link to redirect user to page with all posts with type article%>
              <li class="nav-item">
                  <%= link_to "News", posts_path(post_type: 'article'), class: "nav-link navTextStyling", style: "color:azure;", id: "navNews" %>
              </li>
              <%#Link to redirect user to page with all posts with type post%>
              <li class="nav-item">
                <%= link_to "Forum", posts_path(post_type: 'post'), class: "nav-link navTextStyling", style: "color:azure;", id: "navForum" %>
              </li>
              <%#Check if user is logged in%>
              <% if user_signed_in? %>
                <li class="nav-item" style="margin-left:40px">
                  <%#If user is logged in show a link to redirect user to page with all of their activity%>
                  <%= link_to "My Activity", activity_users_path, class: "nav-link navTextStyling", style: "color:azure;" %>
                </li>
              <% end %>
            </ul>
            <ul class="nav navbar-nav ms-auto" id="navSearch">
              <%#Create a form for post searching%>
              <%= form_tag(search_path, method: :get, id: 'search-form', class: 'form-inline my-2 my-lg-0') do %>
                <%#Create a text field to input user query, searching is made by querying post title%>
                <%= text_field_tag 'query', params[:query], class: 'form-control mr-sm-2', id: 'search-input', placeholder: 'Search', aria: { label: 'Search' } %>
              <% end %>
            </ul>
            <ul class="nav navbar-nav">
              <%#Check if user is signed in%>
              <% if user_signed_in? %>
                <%#Notification icon, when clicked will show a sidebar with notifications, use void to not do any link associated actions %>
                <li class="nav-item notification-icon" style="position: relative;">
                  <%= link_to "javascript:void(0)", class: "nav-link", id: "notificationBell" do %>
                    <i class="bi bi-bell-fill" style="color: azure; font-size: 1.2rem;"></i>
                    <%#If user has any unread messages create a circle with unread message count in middle%>
                    <% if current_user.notifications.unread.any? %>
                      <span class="badge bg-danger notification-badge">
                        <%= current_user.notifications.unread.count %>
                      </span>
                    <% end %>
                  <% end %>
                </li>
                <%#Dropdown for user actions, for basic users will only show logout%>
                <li class="nav-item my-lg-0 my-2 dropdown">
                  <%#As dropdown button text show user username%>
                  <a style="color:azure;" class="nav-link navTextStyling dropdown-toggle" href="#" role="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <%= current_user.user_name %>
                  </a>
                  <ul class="dropdown-menu" aria-labelledby="userDropdown">
                    <%#Show logout link to authenticated users%>
                    <li><%= button_to "Logout", destroy_user_session_path, method: :delete, class: "dropdown-item" %></li>
                    <%#If user is an admin give them an option to go to archived posts page%>
                    <% if user_signed_in? && current_user.admin? %>
                    <li>
                      <%#Link to go to archived posts page%>
                      <%= link_to "Archived", posts_path(archived: true), class: "dropdown-item", style: "color:black" %>
                    </li>
                    <li>
                      <%#Additional option for admin users, when clicked shows a modal to manage categories%>
                      <a href="#" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#categoryModal">Manage Categories</a>
                    </li>
              <% end %>

                  </ul>
                </li>
              <% else %>
              <%#Otherwise, since user not logged in show login button%>
                <li class="nav-item my-lg-0 my-2">
                  <a style="color:azure;" class="nav-link navTextStyling" href="#" data-bs-toggle="modal" data-bs-target="#loginModal">Login</a>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      </nav>
    </div>
  </div>    
</body>

<script>
  //Handle category deletion
  document.addEventListener('DOMContentLoaded', () => {
    const deleteForm = document.getElementById('delete-category-form');
    const selectDropdown = document.getElementById('delete-category-select');

    deleteForm.addEventListener('submit', function (e) {
      const categoryId = selectDropdown.value;
      deleteForm.action = `/categories/${categoryId}`;
    });

    //Reload page if successful deletion
    deleteForm.addEventListener('ajax:success', () => {
      location.reload();
    });
  });
</script>



<script>
$(document).on('submit', '#search-form', function(e) {
  //Make sure user can't spam submit 
  e.preventDefault();
  var searchValue = $('#search-input').val();
  if (searchValue.length >= 2) {
    window.location.href = '/search?q[title_cont]=' + searchValue;
  } else {
    document.getElementById('search-form').reset();
  }
});


document.addEventListener('DOMContentLoaded', function() {
  document.getElementById('search-input').addEventListener('keydown', function(e) {
    if (e.key === 'Enter') {
      var searchValue = $('#search-input').val();
      if (searchValue.length >= 2) {
        $(document.getElementById('search-form')).trigger('submit');
      }
    }
  });
});


$(document).on('turbo:load', function(e) {
  $('#loginModal').modal({
    show: false
});

$("#loginModalForm").on('submit', function(event) {
  event.preventDefault();
  $('div.alert-warning').remove();
  Rails.fire(this, 'submit');
  });
});


$(document).on('submit', '#search-form', function(e) {
  e.preventDefault();
  var searchValue = $('#search-input').val().trim();
  if (searchValue.length >= 2) {
    window.location.href = '/search?q=' + encodeURIComponent(searchValue);
  } else {
    $('#search-input').val('');
  }
});

</script>

